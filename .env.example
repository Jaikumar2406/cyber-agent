# AEGIS - Phase 0 environment template. Copy to .env and adjust.
# NOTE: all settings are read under the AEGIS_ prefix (pydantic-settings).

# Application
AEGIS_APP_NAME=AEGIS
AEGIS_ENVIRONMENT=development
AEGIS_DEBUG=true
AEGIS_API_KEY=dev-key-change-me

# Persistence
# Production path uses PostgreSQL (asyncpg). Tests fall back to SQLite (aiosqlite).
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@db:5432/aegis
AEGIS_REDIS_URL=redis://redis:6379/0

# Control plane - single tenant
AEGIS_DEFAULT_USER=admin

# Scope & policy defaults (Phase 0 stubs - enforcement lives in Phase 1.1)
# Comma separated list of authorized target hosts (empty string = nothing is
# implicitly authorized; explicit approval is required before any scan target)
AEGIS_ALLOWED_TARGETS=

# Phase 1.1 Scope & Policy Guard configuration
AEGIS_ALLOWED_DOMAINS=               # empty -> falls back to ALLOWED_TARGETS host rules
AEGIS_BLOCKED_DOMAINS=               # hard block; wins over allowed
AEGIS_ALLOWED_CIDRS=                 # e.g. 10.0.0.0/8,192.168.0.0/16 (empty = no IP-range check)
AEGIS_BLOCKED_CIDRS=
AEGIS_ALLOWED_PATH_GLOBS=            # empty = all paths within an authorized host
AEGIS_DENIED_PATH_GLOBS=             # hard block; wins over allowed
AEGIS_DEFAULT_INTENSITY=passive      # passive | active | aggressive

# Local ephemeral canary listener for SSRF validation (localhost only, rules.md §3.5)
AEGIS_CANARY_HOST=127.0.0.1
AEGIS_CANARY_PORT=0                  # 0 = ephemeral port

# Harness defaults
AEGIS_SANDBOX_MODE=process          # process | docker
AEGIS_MAX_TOOL_TIMEOUT_SECONDS=30
AEGIS_MAX_TOOL_CALLS=100
AEGIS_MAX_LLM_CALLS=50
AEGIS_MAX_SCAN_SECONDS=1800
AEGIS_MAX_RETRIES=3
AEGIS_RETRY_BASE_BACKOFF_SECONDS=0.5

# Phase 1.2 Attack Surface Discovery - crawler caps
AEGIS_DISCOVERY_MAX_PAGES=20
AEGIS_DISCOVERY_MAX_DEPTH=3